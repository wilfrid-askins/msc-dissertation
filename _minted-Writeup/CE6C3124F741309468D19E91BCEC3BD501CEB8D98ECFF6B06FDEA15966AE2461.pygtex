\begin{Verbatim}[commandchars=\\\{\}]
\PYG{n+nt}{version}\PYG{p}{:} \PYG{l+s}{\PYGZdq{}3.9\PYGZdq{}}  \PYG{c+c1}{\PYGZsh{} optional since v1.27.0}
\PYG{n+nt}{services}\PYG{p}{:}
